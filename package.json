{
  "name": "material-e621-next",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "npm": ">=8.0.0",
    "yarn": "not allowed",
    "pnpm": "not allowed",
    "node": ">=24.0.0"
  },
  "engine-strict": true,
  "scripts": {
    "dev": "vite",
    "build": "npm run generate-pwa-assets && run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "format": "prettier --write src/",
    "generate-pwa-assets": "pwa-assets-generator"
  },
  "dependencies": {
    "@asika32764/vue-animate": "^3.0.2",
    "@fontsource/roboto": "^5.3.0",
    "@mdi/font": "^7.4.47",
    "@types/clone": "^2.1.4",
    "@types/lodash": "^4.17.27",
    "@unhead/vue": "^3.4.3",
    "clone": "^2.1.2",
    "comlink": "^4.4.2",
    "date-fns": "^4.4.0",
    "hammerjs": "^2.0.8",
    "localforage": "^1.10.0",
    "lodash": "^4.18.1",
    "mousetrap": "^1.6.5",
    "pinia": "^4.1.0",
    "portal-vue": "^3.0.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0",
    "vuedraggable": "^4.1.0",
    "vuetify": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tsconfig/node24": "^24.0.6",
    "@types/hammerjs": "^2.0.46",
    "@types/jsdom": "^30.0.0",
    "@types/mousetrap": "^1.6.15",
    "@types/node": "^24.19.2",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-plugin-oxlint": "^1.93.0",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-vue": "~10.12.1",
    "eslint-plugin-vuetify": "^2.7.3",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "npm-run-all2": "^9.0.4",
    "oxlint": "^1.93.0",
    "prettier": "3.10.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "workbox-build": {
      "glob": "^13.0.7"
    }
  }
